{
  "manifest_version": 3,
  "name": "测试平台录制助手",
  "version": "1.0.0",
  "description": "在浏览器中录制 HTTP 请求，自动上传到测试平台",
  "permissions": [
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "测试平台录制助手"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
